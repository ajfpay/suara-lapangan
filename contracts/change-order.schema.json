{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suara-lapangan.local/contracts/change-order.schema.json",
  "title": "Berita Acara / Change Order (K2, schema ready only)",
  "description": "Contract frozen at Day 1 for the verbal change order that gets lost on site. No end-to-end flow ships for this document in the hackathon scope, and it must not be claimed as working. Same strictness as quotation.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jenis",
    "locale",
    "mata_uang",
    "nomor",
    "tanggal",
    "proyek",
    "alasan_perubahan",
    "pekerjaan_tambahan",
    "total_tambahan",
    "terbilang",
    "disetujui_oleh",
    "butuh_konfirmasi"
  ],
  "properties": {
    "jenis": { "type": "string", "enum": ["berita_acara"] },
    "locale": { "type": "string", "enum": ["en", "id"] },
    "mata_uang": { "type": "string", "enum": ["USD", "IDR"] },
    "nomor": {
      "type": "string",
      "pattern": "^SL/BAP/\\d{4}-\\d{2}-\\d{2}/\\d{3}$",
      "description": "Server-made. BAP = berita acara pekerjaan."
    },
    "tanggal": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "proyek": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nama", "lokasi", "klien"],
      "properties": {
        "nama": { "type": "string", "minLength": 1 },
        "lokasi": { "type": "string", "minLength": 1 },
        "klien": { "type": "string", "minLength": 1 }
      }
    },
    "alasan_perubahan": { "type": "string", "minLength": 1 },
    "pekerjaan_tambahan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uraian",
          "volume",
          "satuan",
          "harga_satuan",
          "jumlah",
          "sumber_kutipan"
        ],
        "properties": {
          "uraian": { "type": "string", "minLength": 1 },
          "volume": { "type": "number", "exclusiveMinimum": 0 },
          "satuan": {
            "type": "string",
            "enum": [
              "m2",
              "m3",
              "meter",
              "sq_ft",
              "lin_ft",
              "sak",
              "batang",
              "titik",
              "bag",
              "sheet",
              "bar",
              "point",
              "hour",
              "unit",
              "hari",
              "fixture"
            ]
          },
          "harga_satuan": { "type": "number", "minimum": 0 },
          "jumlah": {
            "type": "number",
            "minimum": 0,
            "description": "Server-computed: volume × harga_satuan."
          },
          "sumber_kutipan": { "type": "string", "pattern": "^turn_[0-9]+$" }
        }
      }
    },
    "total_tambahan": {
      "type": "number",
      "minimum": 0,
      "description": "Server-computed: the sum of every pekerjaan_tambahan[].jumlah."
    },
    "terbilang": { "type": "string", "minLength": 1 },
    "disetujui_oleh": { "type": "string", "minLength": 1 },
    "butuh_konfirmasi": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "alasan", "sumber_kutipan"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "alasan": { "type": "string", "minLength": 1 },
          "sumber_kutipan": {
            "type": ["string", "null"],
            "pattern": "^turn_[0-9]+$"
          }
        }
      }
    }
  }
}
