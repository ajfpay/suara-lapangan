# Suara Lapangan environment variables (copy to .env and fill in).
#
# Secret values never appear in code, config files, logs, or error bodies.

# --- Documents (Postgres) ---
DATABASE_URL=postgresql://appuser:password@localhost:5432/suara

# Where rendered PDFs are stored on disk (default: ./data/pdf).
PDF_STORAGE_DIR=./data/pdf

# --- Email (Kirim) ---
# All five are required; without any of them the send route answers
# 503 email_not_configured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional:
# SMTP_SECURE=true enables implicit TLS (default: true only for port 465).
# SMTP_REQUIRE_TLS=false disables the STARTTLS requirement. Only set this for
# local test relays that do not support STARTTLS (e.g. Mailpit). Without it,
# a non-secure connection must still upgrade via STARTTLS.
# SMTP_SECURE=
# SMTP_REQUIRE_TLS=
