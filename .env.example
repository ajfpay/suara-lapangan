# Suara Lapangan environment variables (copy to .env and fill in).
#
# Secret values never appear in code, config files, logs, or error bodies.

# --- Documents (Postgres) ---
DATABASE_URL=postgresql://appuser:password@localhost:5432/suara

# Where rendered PDFs are stored on disk (default: ./data/pdf).
PDF_STORAGE_DIR=./data/pdf

# --- Email (Kirim via Gmail API) ---
# All three GMAIL_* credentials are required; without them the send route
# answers 503 email_not_configured.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional: GMAIL_FROM overrides the From header. When unset the header is
# omitted and Gmail sets it to the authenticated account.
# GMAIL_FROM=

# EMAIL_DAILY_SEND_LIMIT: positive integer daily send quota across all recipients (default: 100).
# Values above 10000 are rejected as likely typos and fall back to the default.
# The day boundary is UTC (the quota resets at 07:00 WIB).
# EMAIL_DAILY_SEND_LIMIT=100

# BETTER_AUTH_SECRET: secret used to sign auth cookies. Required for any
# deployment; if unset the development fallback is used (never in production).
# BETTER_AUTH_SECRET=

# EMAIL_ALLOWLIST: optional comma-separated list of allowed recipient email addresses.
# Empty or unset disables the allowlist and permits sending to any recipient (default MVP behavior).
# When set, matching is exact after trimming and lowercasing, so plus-addressing
# (user+tag@example.com) does not match user@example.com. Recipients not matching
# any listed address are rejected with 403.
# EMAIL_ALLOWLIST=
