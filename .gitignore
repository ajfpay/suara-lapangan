# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# local env files
.env
.env*.local
.vercel

# Puppeteer downloads its Chromium into the project unless told otherwise.
/.cache

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Local scratch
/.scratch/
/.amp/

# Claude Code local state
/.claude/settings.local.json

# next-env.d.ts is deliberately NOT ignored: it declares the module types
# (`*.css` and friends) that `tsc --noEmit` needs before a build has run.

# suara-lapangan starters (klon referensi, bukan artefak)
.scratch/suara-lapangan-starters/
